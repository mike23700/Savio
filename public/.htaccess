# ---------------------------------------------------------------------------
# Frontend — React SPA (Vite build)
#
# This file lives in public/ so Vite copies it verbatim into dist/. It is
# intended for an Apache shared host (IONOS) where the frontend subdomain's
# document root points to the folder holding index.html.
# ---------------------------------------------------------------------------

Options -MultiViews -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Existing files and folders (assets, images, robots.txt…) are served
    #    directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. Never let a missing static asset fall back to index.html: it would be
    #    returned with a 200 and a wrong Content-Type, hiding the real 404.
    RewriteRule ^assets/ - [L,R=404]

    # 3. Everything else is a client-side route handled by React Router.
    RewriteRule ^ index.html [L]
</IfModule>

# Hashed Vite assets never change: cache them for a year.
<IfModule mod_headers.c>
    <FilesMatch "\.(?:js|css|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|avif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Runtime configuration is editable on the server: never cache it.
    <Files "config.js">
        Header set Cache-Control "no-cache"
    </Files>

    # index.html must be revalidated so a new deployment is picked up.
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
        application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml \
        application/javascript application/json application/xml image/svg+xml
</IfModule>

# Do not serve dotfiles that may be uploaded by mistake.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
