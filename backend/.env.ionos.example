# ---------------------------------------------------------------------------
# Laravel API — IONOS shared hosting (production)
#
# Copy this file to backend/.env on the server, then replace every value
# marked with xxxx / example.com. NEVER commit backend/.env.
#
#   cp .env.ionos.example .env
#   php artisan key:generate
#
# The API subdomain must point to backend/public/, not backend/ itself.
# ---------------------------------------------------------------------------

APP_NAME="Paroisse Saint Dominique Savio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Public URL of the API subdomain (no trailing slash).
APP_URL=https://savio-api.cwen-network.org
FORCE_HTTPS=true

# Exact browser origins allowed by CORS, comma-separated, no trailing slash.
# Include every hostname that serves the frontend (with and without www).
FRONTEND_URL=https://savio.cwen-network.org

# Optional regex for preview/deploy domains. Leave empty on IONOS.
# Example for Vercel previews: #^https://savio-[a-z0-9-]+\.vercel\.app$#
FRONTEND_ORIGIN_PATTERN=

# Domains allowed to use Sanctum's cookie-based SPA mode. The app uses
# Bearer tokens, but keeping this aligned avoids surprises.
SANCTUM_STATEFUL_DOMAINS=savio.cwen-network.org,savio-api.cwen-network.org

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# IONOS database details (Databases → your database → Connection data).
# The host is usually db-xxxxxxxx.hosting-data.io, NOT 127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=db5021733227.hosting-data.io
DB_PORT=3306
DB_DATABASE=dbs16264051
DB_USERNAME=dbu5503547
DB_PASSWORD=savio@237!

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# The app does not send e-mail yet (contact messages are stored in the DB).
# Switch to IONOS SMTP if you add notifications.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@savio.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional: mobile money payments. Leave PEEX_SECRET_KEY empty to keep the
# manual payment instructions. Production base URL:
# PEEX_BASE_URL=https://server.peexit.com/api/v1/
PEEX_BASE_URL=https://sandbox.peexit.com/api/v1/
PEEX_SECRET_KEY=
PEEX_CALLBACK_USERNAME=
PEEX_CALLBACK_PASSWORD=

# First admin account, used only by AdminUserSeeder. Set a strong password
# BEFORE running the first `db:seed`. An existing account is never overwritten.
ADMIN_EMAIL=admin@savio.example.com
ADMIN_PASSWORD=change-me-before-seeding
