# ---------------------------------------------------------------------------
# Production environment for the VPS (Docker + host nginx).
#
# Copy this file to .env with `make env` (it also generates APP_KEY and the
# database passwords), then edit the values marked CHANGE ME.
#
#   cp .env.docker.example .env    # make env does this and fills the secrets
#
# The same .env is read by docker compose for interpolation and injected into
# the api container through env_file. It is git-ignored: never commit it.
# ---------------------------------------------------------------------------

APP_NAME="Paroisse Saint Dominique Savio"
APP_ENV=production
APP_DEBUG=false
APP_KEY=

# Public API origin. Laravel builds upload URLs as APP_URL/storage/<path>.
APP_URL=https://savio-api.cwen-network.org

# Exact browser origin allowed by CORS. No trailing slash, no path.
FRONTEND_URL=https://savio.cwen-network.org

# Trust the TLS termination done by host nginx.
FORCE_HTTPS=true

# Absolute API root used at build time by the frontend bundle. Must end in /api.
API_URL=https://savio-api.cwen-network.org/api

# Loopback port where the api container publishes PHP-FPM for host nginx.
# Must match fastcgi_pass in deploy/nginx/savio-api.cwen-network.org.conf.
API_FCGI_PORT=9201

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=savio_paroisse
DB_USERNAME=savio
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=savio.cwen-network.org

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# First admin, used once by AdminUserSeeder. Existing accounts are never
# overwritten. Remove these lines after the first login.
# ADMIN_EMAIL=admin@savio.com
# ADMIN_PASSWORD=change-me-before-seeding

# Peex mobile money (Orange Money / MTN MoMo). Leave PEEX_SECRET_KEY empty to
# keep the manual payment instructions.
# PEEX_BASE_URL=https://sandbox.peexit.com/api/v1/
# PEEX_SECRET_KEY=
# PEEX_CALLBACK_USERNAME=
# PEEX_CALLBACK_PASSWORD=
