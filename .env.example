# ---------------------------------------------------------------------------
# Frontend environment (Vite)
#
# Local development:
#   Leave VITE_API_URL empty. The Vite dev server proxies /api and /storage
#   to VITE_API_PROXY_TARGET (default http://127.0.0.1:8001).
#
# Production (IONOS):
#   VITE_API_URL must be the absolute URL of the Laravel API, including the
#   /api suffix, e.g. https://api.savio.example.com/api
#   It is baked into the bundle at build time: rebuild after changing it.
# ---------------------------------------------------------------------------

VITE_API_URL=

# Only used by the local Vite dev/preview servers (not shipped to the browser).
VITE_API_PROXY_TARGET=http://127.0.0.1:8001
